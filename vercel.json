{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "pnpm install --frozen-lockfile",
    "buildCommand": "pnpm run build",
    "outputDirectory": "dist",
    "headers": [
        {
            "source": "/build-info.json",
            "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        }
    ],
    "git": {
        "deploymentEnabled": {
            "main": true,
            "**": false
        }
    }
}
