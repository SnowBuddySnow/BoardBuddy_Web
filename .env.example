VITE_KAKAO_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY
# Optional: when omitted, the login button falls back to GET /api/auth/social/naver/config.
VITE_NAVER_CLIENT_ID=
# Optional: defaults to the current web origin + pathname (e.g. https://boardbuddy.kr/).
VITE_NAVER_REDIRECT_URI=
# Optional: SEASON, OFF_SEASON, or BOTH. Empty uses the calendar-based default.
VITE_OPERATING_MODE_OVERRIDE=

# Local development uses the Vite proxy. Override this in hosted environments:
# develop/Preview -> https://api-stg.boardbuddy.kr/api
# main/Production -> https://api.boardbuddy.kr/api
VITE_API_BASE_URL=/api

# Optional emergency switch for school-email verification entry points.
VITE_SCHOOL_EMAIL_AUTH_AVAILABLE=true

# Set only after these scopes are approved/enabled in Kakao Developers.
# VITE_KAKAO_SIGNUP_SCOPES=name,gender,phone_number
