VITE_KAKAO_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY
# Optional: SEASON, OFF_SEASON, or BOTH. Empty uses the calendar-based default.
VITE_OPERATING_MODE_OVERRIDE=

# Local development uses the Vite proxy. Override this in hosted environments:
# develop/Preview -> https://api-stg.boardbuddy.kr/api
# main/Production -> https://api.boardbuddy.kr/api
VITE_API_BASE_URL=/api
