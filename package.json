{
  "name": "client",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "node scripts/dev/onboarding-preview.mjs",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=output/test-results/unit.xml",
    "typecheck": "tsc -b",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "preview": "vite preview",
    "check:contracts": "node scripts/check-api-contract.mjs",
    "test:browser": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:browser:extended": "playwright test --project=firefox-desktop --project=webkit-mobile",
    "test:management": "node scripts/test/run-mobile-management.mjs",
    "test:onboarding": "node scripts/test/run-onboarding-browser.mjs",
    "test:season-stays": "node scripts/test/run-season-stays.mjs",
    "test:notifications-groups": "node scripts/test/run-notifications-and-groups.mjs"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@sentry/react": "^10.74.0",
    "animejs": "^4.5.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.554.0",
    "motion": "^14.14.0",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.34",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^27.4.0",
    "playwright": "1.65.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
